# Skopiuj ten plik do .env i wpisz swoją domenę (rekord DNS A/AAAA musi wskazywać na serwer).
# Plik .env nie jest częścią repozytorium (jest w .gitignore).
DOMAIN=forecast.example.com

# Tylko do testu lokalnego (na serwerze zostaw puste, wtedy używane są porty 80 i 443):
# HTTP_PORT=8081
# HTTPS_PORT=8443
